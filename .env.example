# SICHTWERK Studio – Umgebungsvariablen
# Lokal: als .env.local kopieren. Vercel: Project → Settings → Environment Variables.

# Zugangsschutz für /studio und alle kostenpflichtigen API-Routen (in Produktion Pflicht)
STUDIO_PASSWORD=

# Claude: Analysen, Skripte, Trend-Websuche, Schnittplan, Viral-Rating
ANTHROPIC_API_KEY=
# Optional: anderes Modell (Standard: claude-opus-5-5)
# STUDIO_MODEL=claude-opus-5-5

# Apify: echte TikTok- und Instagram-Daten
APIFY_API_TOKEN=
# Optional: Kostendeckel pro Scraper-Lauf in USD (Standard: 5)
# APIFY_MAX_CHARGE_USD=5

# ElevenLabs: Sprecherstimme (KI-Video) und automatische Untertitel (eigene Clips)
ELEVENLABS_API_KEY=
# Optional: Standardstimme
# ELEVENLABS_VOICE_ID=

# fal.ai: KI-Videoszenen (Kling 3 / Veo 3.1)
FAL_KEY=
