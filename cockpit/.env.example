# ─── Pflicht ────────────────────────────────────────────────────────────────
# Langer Zufallswert (mind. 32 Zeichen). Signiert Logins und verschlüsselt
# gespeicherte API-Tokens. Erzeugen z. B. mit:  openssl rand -base64 48
APP_SECRET=

# Öffentliche Adresse der Software (für OAuth-Rückleitungen, Tracking-Links,
# Kundenreports und Kalender-Abos), ohne Schrägstrich am Ende.
APP_URL=http://localhost:3100

# ─── Datenbank ──────────────────────────────────────────────────────────────
# Lokal reicht eine Datei. Für den Online-Betrieb (z. B. Vercel) eine Turso-
# Datenbank anlegen und deren URL + Token eintragen.
DATABASE_URL=file:./data/cockpit.db
DATABASE_AUTH_TOKEN=

# Schützt /api/cron/* (Synchronisation, Serienrechnungen, Fälligkeiten).
CRON_SECRET=

# ─── E-Mail (Versand per SMTP, Empfang per IMAP) ───────────────────────────
# Alternativ in der Software unter Einstellungen → E-Mail eintragen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ─── Plattform-Anbindungen (jeweils eigene Entwickler-App nötig) ───────────
# TikTok for Developers  → Login Kit + Display API (Scopes: user.info.basic,
#                          user.info.stats, video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers   → eine App für Instagram, Facebook-Seiten und Meta Ads
META_APP_ID=
META_APP_SECRET=
# Instagram API mit Instagram-Login (eigene Instagram-App-ID innerhalb der Meta-App)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Google Cloud          → OAuth-Client (Web) für Google Ads + Unternehmensprofil
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API: Developer Token aus dem Verwaltungskonto (MCC)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# Google Places API (New) – Sterne & Bewertungsanzahl ohne Kunden-Login
GOOGLE_PLACES_API_KEY=
