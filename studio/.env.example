# ── Pflicht ────────────────────────────────────────────────────────────────
# Claude-API-Schlüssel: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=

# Passwort für das Studio (Pflicht, sobald es online erreichbar ist).
# Leer lassen = kein Login (nur für lokale Nutzung).
STUDIO_PASSWORD=

# ── Optional: Live-Daten ───────────────────────────────────────────────────
# Apify (TikTok-, Instagram- und Google-Maps-Daten): https://console.apify.com → Settings → API & Integrations
APIFY_TOKEN=

# Google API Key mit aktivierter "PageSpeed Insights API" (für Website-/Speed-Checks).
# Ohne Key funktioniert es meist auch, aber mit sehr kleinem Kontingent.
GOOGLE_API_KEY=

# Higgsfield (KI-Video & -Bild direkt aus dem Studio): https://console.higgsfield.ai
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ── Optional: gemeinsamer Speicher für Deployment (Vercel) ─────────────────
# Ohne diese Werte speichert das Studio lokal im Ordner ./data.
# Auf Vercel: Marketplace → "Upstash for Redis" verbinden, die Variablen werden automatisch gesetzt.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
